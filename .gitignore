# MiBee Cam family .gitignore (byte-identical across the four cam repos)

# Build artifacts
build/
build2/
build3/
out/
output/
dist/
partition_table/
bootloader/build/

# ESP-IDF generated config (sdkconfig.defaults stays tracked; local sdkconfig
# is the injection point for local-only credentials — never commit it)
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# Binary / object artifacts
*.o
*.obj
*.a
*.so
*.d
*.elf
*.bin
*.hex
*.map
*.lst

# Editor / IDE / index
.vscode/
.idea/
*.iml
*.user
.clangd/
.ccls-cache/
compile_commands.json
.trae/
codegraph/
.codegraph/

# Internal tool caches
.sisyphus/
.omo/
.cache/
setup_idf_env.ps1
package-lock.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.gcda
*.gcno
*.gcov

# Logs and local runtime artifacts (serial collectors etc.)
*.log
*.out
*.tmp
*.temp
tools/overnight_serial.log
tools/overnight_reboots.log

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
*.lnk
._*
.Spotlight-V100
.Trashes
ehthumbs.db
*~
*.swp
*.swo
*.bak
*#

# Local-only content
/*-test.png
/*-check.png
tmp/
docs/superpowers/
docs/stream-push-analysis/
.github/copilot-instructions.md
config.txt
verify_hardware.bat
build_log.txt
.playwright-mcp/
$null
